import Mathlib

/-!
# The two rings on one carrier (ledger rows C1, C3, C4, C5, C8, C9, C11, C17)

The corpus stores a "DNA" as a coefficient sequence `a : ℕ → R` and composes two DNAs in two
different ways:

* **Ring A** (geometric composition, multiplying `q`-series): the *Cauchy* product
  `(a ⋆ b)(n) = ∑_{i + j = n} a(i) b(j)`. This is `PowerSeries R`.
* **Ring B** (the Dirichlet ring, multiplying `∑ a(n) n^{-s}`): the *Dirichlet* product
  `(a * b)(n) = ∑_{d e = n} a(d) b(e)`. This is Mathlib's `ArithmeticFunction R`.

The corpus' prose once called these "the same operation in two realisations" (ledger C2,
refuted). This file makes the difference precise:

1. `cauchy_ne_dirichlet` — the corpus' own witness: squaring the all-ones sequence gives `0`
   at index 1 in Ring A and `1` in Ring B.
2. `delta_is_X` — the Dirichlet identity `δ = [n = 1]` is the *variable* `X` in Ring A, not
   its identity (ledger C3).
3. **`ArithmeticFunction.not_isPrincipalIdealRing`** and **`not_ringEquiv_powerSeries`** — the
   real content: over a field `K` the two rings are **not isomorphic** as rings. `K⟦X⟧` is a
   discrete valuation ring (every ideal principal), while in the Dirichlet ring the ideal
   `(δ₂, δ₃)` — "divisible by 2 or by 3" — is not principal. Conceptually: the Cauchy ring is
   the completed monoid ring of `(ℕ, +)` (one generator), the Dirichlet ring that of
   `(ℕ_{>0}, ×) ≅ ⊕_p ℕ` (one generator per prime).
4. Classical identities the corpus uses, as Mathlib-backed statements: Möbius inversion
   `ζ * μ = 1` (C4), `ζ * ζ = σ₀` (C5), `σ₃ = ζ * Id³` and the refutation `σ₃ ≠ ζ⁴` (C8),
   `f ↦ f · log` is a derivation (C9), multiplicative functions form a submonoid (C11).
-/

open ArithmeticFunction PowerSeries
open scoped ArithmeticFunction.zeta ArithmeticFunction.Moebius ArithmeticFunction.sigma

namespace Fugue

/-! ### 1. The witness: the two products disagree on `ζ` -/

/-- The all-ones DNA `(0, 1, 1, 1, …)` as an element of Ring A. -/
noncomputable def onesA (R : Type*) [Semiring R] : PowerSeries R :=
  PowerSeries.mk fun n => if n = 0 then 0 else 1

/-- In Ring A, `(ζ ⋆ ζ)(1) = 0` … -/
theorem coeff_one_onesA_sq (R : Type*) [Semiring R] : coeff 1 (onesA R * onesA R) = 0 := by
  rw [coeff_mul, Finset.Nat.antidiagonal_succ]
  simp [onesA]

/-- … while in Ring B, `(ζ * ζ)(1) = 1`. -/
theorem zeta_mul_zeta_apply_one (R : Type*) [Semiring R] :
    ((ζ : ArithmeticFunction R) * ζ) 1 = 1 := by
  simp

/-- **Ledger C1.** The same coefficient sequence squares to different things in the two rings. -/
theorem cauchy_ne_dirichlet (R : Type*) [Semiring R] [Nontrivial R] :
    coeff 1 (onesA R * onesA R) ≠ ((ζ : ArithmeticFunction R) * ζ) 1 := by
  rw [coeff_one_onesA_sq, zeta_mul_zeta_apply_one]; exact zero_ne_one

/-- **Ledger C3.** The Dirichlet identity `δ = [n = 1]`, read as a Ring-A DNA, is the variable
`X` — a shift, not a "do-nothing" element. -/
theorem delta_is_X (R : Type*) [Semiring R] :
    PowerSeries.mk (fun n => if n = 1 then (1 : R) else 0) = X := by
  ext n; simp [coeff_X]

theorem X_ne_one (R : Type*) [Semiring R] [Nontrivial R] : (X : PowerSeries R) ≠ 1 := by
  intro h
  have := congrArg (coeff 0) h
  simp at this

/-! ### 2. The two rings are not isomorphic -/

/-- The indicator `δₙ` of a single index `n ≥ 1`, as an arithmetic function. -/
def delta (R : Type*) [Zero R] [One R] (n : ℕ) (hn : n ≠ 0) : ArithmeticFunction R :=
  ⟨fun m => if m = n then 1 else 0, by simp [Ne.symm hn]⟩

@[simp] theorem delta_apply {R : Type*} [Zero R] [One R] {n : ℕ} (hn : n ≠ 0) (m : ℕ) :
    delta R n hn m = if m = n then 1 else 0 := rfl

theorem mul_apply_two {R : Type*} [Semiring R] (f g : ArithmeticFunction R) :
    (f * g) 2 = f 1 * g 2 + f 2 * g 1 := by
  rw [mul_apply, show Nat.divisorsAntidiagonal 2 = {(1, 2), (2, 1)} from rfl]
  simp

theorem mul_apply_three {R : Type*} [Semiring R] (f g : ArithmeticFunction R) :
    (f * g) 3 = f 1 * g 3 + f 3 * g 1 := by
  rw [mul_apply, show Nat.divisorsAntidiagonal 3 = {(1, 3), (3, 1)} from rfl]
  simp

/-- **The Dirichlet ring is not a principal ideal ring** (over any integral domain): the ideal
generated by `δ₂` and `δ₃` is not principal.

Proof. If `(δ₂, δ₃) = (g)`, then `g = aδ₂ + bδ₃` vanishes at `1`. Writing `δ₂ = h g` and
`δ₃ = h' g` and evaluating at `2` gives `h(1) g(2) = 1` and `h'(1) g(2) = 0`, so `h'(1) = 0`;
evaluating `δ₃ = h' g` at `3` then gives `1 = h'(1) g(3) + h'(3) g(1) = 0`. -/
theorem ArithmeticFunction.not_isPrincipalIdealRing (R : Type*) [CommRing R] [IsDomain R] :
    ¬ IsPrincipalIdealRing (ArithmeticFunction R) := by
  intro hPID
  set d2 := delta R 2 two_ne_zero
  set d3 := delta R 3 three_ne_zero
  obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal (Ideal.span {d2, d3})).principal
  have hgI : g ∈ Ideal.span {d2, d3} := by rw [hg]; exact Ideal.mem_span_singleton_self g
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hgI
  have hg1 : g 1 = 0 := by
    rw [← hab]; simp [d2, d3]
  have h2 : d2 ∈ Submodule.span (ArithmeticFunction R) {g} := by
    rw [← hg]; exact Ideal.subset_span (by simp)
  have h3 : d3 ∈ Submodule.span (ArithmeticFunction R) {g} := by
    rw [← hg]; exact Ideal.subset_span (by simp)
  obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp h2
  obtain ⟨h', hh'⟩ := Ideal.mem_span_singleton'.mp h3
  have e2 : h 1 * g 2 = 1 := by
    have := congrArg (· 2) hh; simp only [mul_apply_two, hg1, mul_zero, add_zero] at this
    rw [this]; simp [d2]
  have e2' : h' 1 * g 2 = 0 := by
    have := congrArg (· 2) hh'; simp only [mul_apply_two, hg1, mul_zero, add_zero] at this
    rw [this]; simp [d3]
  have hg2 : g 2 ≠ 0 := right_ne_zero_of_mul_eq_one e2
  have hh'1 : h' 1 = 0 := (mul_eq_zero.mp e2').resolve_right hg2
  have e3 := congrArg (· 3) hh'
  simp only [mul_apply_three, hg1, hh'1, zero_mul, mul_zero, add_zero] at e3
  simp [d3] at e3

/-- **Ledger C1, made rigorous.** Over a field, Ring A (`K⟦X⟧`, Cauchy product) and Ring B
(arithmetic functions, Dirichlet product) are not isomorphic as rings. -/
theorem not_ringEquiv_powerSeries (K : Type*) [Field K] :
    IsEmpty (ArithmeticFunction K ≃+* PowerSeries K) := by
  refine ⟨fun e => ArithmeticFunction.not_isPrincipalIdealRing K ?_⟩
  exact IsPrincipalIdealRing.of_surjective e.symm.toRingHom e.symm.surjective

/-! ### 3. The classical identities the corpus uses -/

/-- **Ledger C4 (Möbius inversion).** `ζ * μ = δ`. -/
theorem zeta_mul_moebius : (ζ * μ : ArithmeticFunction ℤ) = 1 := coe_zeta_mul_moebius

/-- **Ledger C5.** `ζ * ζ = σ₀`, the divisor-counting function. -/
theorem zeta_mul_zeta_eq_sigma_zero : (ζ * ζ : ArithmeticFunction ℕ) = σ 0 := by
  rw [← zeta_mul_pow_eq_sigma, pow_zero_eq_zeta]

/-- **Ledger C8, the correct factorisation.** The E8 theta coefficients `σ₃ = ζ * Id³`. -/
theorem sigma_three_eq : σ 3 = ζ * pow 3 := zeta_mul_pow_eq_sigma.symm

/-- **Ledger C8, the refutation.** `σ₃ ≠ ζ * ζ * ζ * ζ` (the corpus' `dna.py` docstring): at
`n = 2`, `σ₃(2) = 1 + 8 = 9` while `ζ⁴(2) = d₄(2) = 4`. -/
theorem sigma_three_ne_zeta_pow_four : σ 3 ≠ (ζ * ζ * ζ * ζ : ArithmeticFunction ℕ) := by
  intro h
  have h2 := congrArg (· 2) h
  simp only [mul_apply_two, sigma_apply] at h2
  simp at h2
  rw [show Nat.divisors 2 = {1, 2} from rfl] at h2
  simp at h2

/-- **Ledger C9.** Pointwise multiplication by `log n` is a *derivation* of the Dirichlet ring:
`(f * g)·log = (f·log) * g + f * (g·log)`. (It is the arithmetic shadow of `d/ds` on
Dirichlet series: `-d/ds ∑ a(n) n^{-s} = ∑ a(n) log n · n^{-s}`.) -/
theorem pmul_log_mul (f g : ArithmeticFunction ℝ) :
    (f * g).pmul log = f.pmul log * g + f * g.pmul log := by
  ext n
  rw [ArithmeticFunction.add_apply, pmul_apply, mul_apply, mul_apply, mul_apply, Finset.sum_mul,
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun x hx => ?_
  have hx' := Nat.mem_divisorsAntidiagonal.mp hx
  have hn : x.1 * x.2 ≠ 0 := hx'.1 ▸ hx'.2
  have h1 : (x.1 : ℝ) ≠ 0 := by exact_mod_cast left_ne_zero_of_mul hn
  have h2 : (x.2 : ℝ) ≠ 0 := by exact_mod_cast right_ne_zero_of_mul hn
  simp only [pmul_apply, log_apply]
  rw [← hx'.1, Nat.cast_mul, Real.log_mul h1 h2]
  ring

/-- **Ledger C11.** Multiplicative arithmetic functions form a submonoid of the Dirichlet
ring: the single closure law behind the Euler product, `ζ · L(s, χ_D) = ζ_K`, and Hecke
multiplicativity. -/
def multiplicativeSubmonoid (R : Type*) [CommSemiring R] :
    Submonoid (ArithmeticFunction R) where
  carrier := {f | f.IsMultiplicative}
  one_mem' := isMultiplicative_one
  mul_mem' := fun hf hg => hf.mul hg

/-- … and it is *not* closed under addition: `ζ + ζ` takes the value `2` at `1`. So "compose"
means multiply; adding two multiplicative DNAs leaves the locus. -/
theorem zeta_add_zeta_not_multiplicative :
    ¬ ((ζ : ArithmeticFunction ℕ) + ζ).IsMultiplicative := by
  intro h
  have := h.map_one
  simp at this

end Fugue
